---
// One project told as problem → approach → outcome, used inside chapters and
// in the interlude. Styling is self-contained so the card works anywhere.
import type { Project } from '../data/profile';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<article class="card">
  <p class="label">{p.label}</p>
  <h4>{p.title}</h4>
  <p class="problem">{p.problem}</p>
  <p>{p.approach}</p>
  <p class="outcome">{p.outcome}</p>
  {p.link && <a class="card-link" href={p.link.href} target="_blank" rel="noopener noreferrer">{p.link.text} →</a>}
  <ul class="tags">
    {p.tools.map((t) => <li>{t}</li>)}
  </ul>
</article>

<style>
  .card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem; }
  .label { color: var(--accent); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.5rem; }
  h4 { font-family: var(--serif); font-weight: 600; font-size: 1.25rem; line-height: 1.2; margin: 0 0 0.75rem; }
  .problem { color: var(--muted); font-style: italic; }
  .outcome { font-weight: 500; border-top: 1px solid var(--line); padding-top: 0.75rem; }
  .card-link { font-weight: 500; margin-bottom: 1rem; }
  .tags { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li { background: var(--accent-soft); color: var(--ink); font-size: 0.8rem; padding: 0.2rem 0.65rem; border-radius: 999px; }
</style>
