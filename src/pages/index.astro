---
// The whole site is this one page, told as a story: hero (thesis) → four
// chapters in chronological order, each with that era's projects → an
// "off the clock" interlude → an epilogue about what's next.
// All text comes from src/data/profile.ts; this file only arranges it.
// Styles below are scoped to this page; colors come from Base.astro.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, chapters, interlude, epilogue } from '../data/profile';
---

<Base
  title={`${profile.name} · ${profile.role}`}
  description={`${profile.role} in ${profile.location}. ${profile.thesis}`}
>
  <header class="nav wrap">
    <a class="mark" href="#top">RC</a>
    <nav>
      <a href="#story">Story</a>
      <a href="#off-the-clock">Off the clock</a>
      <a href="#next">Next</a>
      <ThemeToggle />
    </nav>
  </header>

  <main id="top">
    <!-- Hero: who, and the idea that ties the story together -->
    <section class="hero wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">{profile.role} · {profile.location}</p>
          <h1>
            {profile.firstName} <span class="nick">“{profile.nickname}”</span>{' '}{profile.lastName}
          </h1>
          <p class="thesis">{profile.thesis}</p>
          <p class="thesis-follow">{profile.thesisFollowUp}</p>
          <div class="cta">
            <a class="btn" href="#story">Read the story ↓</a>
            <a class="btn ghost" href={profile.linkedin} rel="noopener">LinkedIn</a>
          </div>
        </div>
        <img class="headshot" src="/headshot.jpg" alt={`Portrait of ${profile.name}`} width="640" height="640" />
      </div>
    </section>

    <!-- The story: chapters oldest to newest, joined by a vertical spine -->
    <section id="story" class="wrap story">
      {
        chapters.map((c, i) => (
          <article class="chapter" id={c.id}>
            <aside class="meta">
              <p class="chapter-num">Chapter {i + 1}</p>
              <p class="years">{c.years}</p>
              <p class="place">{c.place}</p>
              <p class="role">{c.role}</p>
            </aside>
            <div class="body">
              <h2>{c.title}</h2>
              {c.story.map((p) => <p class="prose">{p}</p>)}
              {c.projects.length > 0 && (
                <div class:list={['projects', { pair: c.projects.length > 1 }]}>
                  {c.projects.map((p) => <ProjectCard project={p} />)}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </section>

    <!-- Interlude: the same curiosity outside work -->
    <section id="off-the-clock" class="wrap interlude">
      <h2>{interlude.title}</h2>
      <p class="lede">{interlude.intro}</p>
      <div class="interests">
        {
          interlude.interests.map((it) => (
            <div class="interest">
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          ))
        }
      </div>
      <div class="side-project">
        <ProjectCard project={interlude.project} />
      </div>
    </section>

    <!-- Epilogue: where the story goes next, and how to get in touch -->
    <section id="next" class="wrap">
      <div class="epilogue">
        <h2>{epilogue.title}</h2>
        <p class="lede">{epilogue.intro}</p>
        <div class="directions">
          {
            epilogue.directions.map((d) => (
              <div>
                <h3>{d.title}</h3>
                <p>{d.text}</p>
              </div>
            ))
          }
        </div>
        <p class="closing">{epilogue.closing}</p>
        <div class="cta">
          <a class="btn" href={profile.linkedin} rel="noopener">Message me on LinkedIn</a>
          <a class="btn ghost" href={profile.github} rel="noopener">GitHub</a>
        </div>
        <div class="toolkit">
          <p>Everyday toolkit</p>
          <ul>
            {epilogue.toolkit.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <p>
      © {new Date().getFullYear()} {profile.name} · Last updated {
        new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
      }
    </p>
  </footer>
</Base>

<style>
  /* Layout: centered content column with a 16px phone gutter. */
  .wrap { max-width: 1040px; margin-left: auto; margin-right: auto; padding: 0 16px; }
  @media (min-width: 720px) { .wrap { padding: 0 32px; } }

  section { margin-top: 5.5rem; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 0.75rem; }
  .lede { color: var(--muted); }

  /* Top navigation. Tighter spacing on small phones so all links fit. */
  .nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.5rem; padding-bottom: 1.5rem; }
  .nav nav { display: flex; gap: 1.25rem; align-items: center; }
  .nav a { color: var(--ink); text-decoration: none; font-size: 0.95rem; white-space: nowrap; }
  .nav nav a:hover { color: var(--accent); }
  .mark { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; }
  @media (max-width: 479px) {
    .nav nav { gap: 0.8rem; }
    .nav nav a { font-size: 0.85rem; }
  }

  /* Hero: name and thesis, headshot to the right on desktop, above on phones. */
  .hero { margin-top: 3rem; }
  .hero-grid { display: grid; gap: 2rem; align-items: center; }
  .headshot {
    order: -1; width: 128px; height: 128px; border-radius: 50%; object-fit: cover;
    border: 4px solid var(--surface); box-shadow: 0 0 0 1px var(--line);
  }
  @media (min-width: 820px) {
    /* minmax(0, 1fr) lets the long name wrap instead of pushing the photo off-screen */
    .hero-grid { grid-template-columns: minmax(0, 1fr) auto; gap: 2.5rem; }
    .headshot { order: 0; width: 200px; height: 200px; }
  }
  @media (min-width: 1040px) { .headshot { width: 240px; height: 240px; } }
  .eyebrow { color: var(--accent); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .hero h1 { font-size: clamp(2.3rem, 6.2vw, 4.2rem); letter-spacing: -0.01em; }
  .nick { color: var(--accent); font-style: italic; font-weight: 500; }
  .thesis { font-family: var(--serif); font-size: clamp(1.25rem, 2.4vw, 1.6rem); line-height: 1.35; max-width: 32ch; margin-top: 1.25rem; }
  .thesis-follow { color: var(--muted); font-size: 1.1rem; margin-top: -0.25rem; }

  /* Buttons. */
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .btn {
    display: inline-block; padding: 0.7rem 1.2rem; border-radius: 999px;
    background: var(--accent); color: var(--bg); text-decoration: none; font-weight: 500;
  }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  .btn:hover { filter: brightness(1.08); }

  /* The story. On desktop each chapter has a sticky meta column (chapter,
     years, place) beside the narrative; a vertical line joins the chapters
     into one spine. On phones the meta sits above the text. */
  .story { position: relative; }
  .chapter { position: relative; display: grid; gap: 1rem; padding: 0 0 4.5rem 1.75rem; }
  .chapter::before { content: ''; position: absolute; left: 4px; top: 0.5rem; bottom: 0; width: 2px; background: var(--line); }
  .chapter::after {
    content: ''; position: absolute; left: 0; top: 0.3rem; width: 10px; height: 10px;
    border-radius: 50%; background: var(--bg); border: 2px solid var(--accent);
  }
  .chapter:last-child::after { background: var(--accent); }
  .chapter:last-child { padding-bottom: 0; }
  .chapter:last-child::before { display: none; }
  @media (min-width: 900px) {
    .chapter { grid-template-columns: 210px 1fr; gap: 2.5rem; }
    .meta { position: sticky; top: 1.5rem; align-self: start; }
  }
  .meta p { margin: 0; }
  .chapter-num { color: var(--accent); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .years { font-family: var(--serif); font-size: 1.5rem; font-weight: 600; margin-top: 0.2rem !important; }
  .place { font-weight: 600; margin-top: 0.35rem !important; }
  .role { color: var(--muted); font-size: 0.95rem; }
  .body h2 { margin-top: -0.2rem; }
  .prose { font-size: 1.125rem; max-width: 62ch; }
  .projects { display: grid; gap: 1rem; margin-top: 1.75rem; }
  @media (min-width: 720px) { .projects.pair { grid-template-columns: 1fr 1fr; } }
  .projects:not(.pair) { max-width: 560px; }

  /* Interlude. */
  .interests { display: grid; gap: 1.75rem 2.5rem; margin-top: 2rem; }
  @media (min-width: 720px) { .interests { grid-template-columns: repeat(3, 1fr); } }
  .interest { border-left: 3px solid var(--accent); padding-left: 1rem; }
  .interest h3 { font-size: 1.15rem; margin-bottom: 0.4rem; }
  .interest p { color: var(--muted); margin: 0; }
  .side-project { max-width: 560px; margin-top: 2.5rem; }

  /* Epilogue card, toolkit line and footer. */
  .epilogue { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 2rem 1.25rem; }
  @media (min-width: 720px) { .epilogue { padding: 3rem; } }
  .directions { display: grid; gap: 1.5rem 2.5rem; margin-top: 1.75rem; }
  @media (min-width: 720px) { .directions { grid-template-columns: 1fr 1fr; } }
  .directions h3 { font-family: var(--sans); font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem; }
  .directions p { color: var(--muted); margin: 0; }
  .closing { font-family: var(--serif); font-size: 1.25rem; margin-top: 2rem; }
  .toolkit { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); }
  .toolkit p { margin: 0 0 0.4rem; font-weight: 600; }
  .toolkit ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }

  footer { margin-top: 4rem; padding-bottom: 2rem; color: var(--muted); font-size: 0.9rem; }
</style>
